# Copy to .env and fill in (never commit .env).
# Loaded by .vscode/launch.json envFile into the process environment.
# cmd/main.go reads these when the matching flags are unset.
#
# Auth: set organisation plus exactly one method below (client credentials, PAT, or token exchange).

THALASSA_URL=https://api.thalassa.cloud
THALASSA_ORGANISATION=

# Region used when Bucket spec.region is empty (--default-region).
# THALASSA_REGION is accepted as a fallback alias for the same purpose.
THALASSA_DEFAULT_REGION=nl-01
# THALASSA_REGION=

# --- Auth option A: OAuth2 client credentials (service account access credentials) ---
THALASSA_CLIENT_ID=
THALASSA_CLIENT_SECRET=
# Prefer a file over THALASSA_CLIENT_SECRET when possible:
# THALASSA_CLIENT_SECRET_FILE=

# --- Auth option B: personal access token ---
# THALASSA_TOKEN=
# THALASSA_TOKEN_FILE=

# --- Auth option C: OIDC token exchange (in-cluster / federated workload identity) ---
# THALASSA_SERVICE_ACCOUNT_ID=
# THALASSA_SUBJECT_TOKEN_FILE=
# THALASSA_SUBJECT_TOKEN=
# THALASSA_OIDC_TOKEN_URL=
# THALASSA_ACCESS_TOKEN_LIFETIME=

# Optional
# THALASSA_PROJECT=
# THALASSA_INSECURE=false

# Kubernetes cluster for local debugging (hack/fetch-kubeconfig.sh / preLaunchTask)
CLUSTER_ID=
# Optional override; launch.json defaults to hack/cluster.kubeconfig
# KUBECONFIG=
